# Koneksi database — sesuaikan dengan environment Anda (PostgreSQL/MySQL/MariaDB).
DATABASE_URL="mysql://root@localhost:3306/siperu"

# Secret untuk menandatangani JWT — WAJIB diganti di production.
JWT_SECRET="siperu-super-secret-change-in-production"

# Durasi token (contoh: 8h, 7d)
JWT_EXPIRES_IN="8h"

# Port server
PORT=4000

# Origin frontend (Vite dev server)
CLIENT_ORIGIN="http://localhost:5173"

# URL webservice eksternal untuk sinkronisasi ruang
EXTERNAL_ROOMS_URL="https://api-ruangan.vercel.app/rooms"
